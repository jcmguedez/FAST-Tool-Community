{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "description": "FAST Desktop Tool - asistente de análisis de sistemas",
  "author": "FAST Desktop Tool",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:local": "concurrently \"npm run server\" \"npm run dev:front\"",
    "dev:front": "vite",
    "server": "node server.cjs",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --outfile=dist-electron/main.js --external:electron",
    "build:app": "npm run build && npm run build:electron",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:win": "npm run build:app && electron-builder --win nsis --x64",
    "rebuild:sqlite": "electron-builder install-app-deps",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/html2canvas": "^0.5.35",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.fast.desktoptool",
    "productName": "FAST Desktop Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "server.cjs",
        "to": "app/server.cjs"
      },
      {
        "from": "dist",
        "to": "app/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FAST Desktop Tool"
    }
  }
}
